# Comma-separated browser origins allowed to call this API with cookies.
CORS_ORIGIN=http://localhost:3000

# Atlas connection used only by this API.
MONGODB_URI=
MONGODB_DB=aif_wealthdiscovery

# Signs the session cookie.
AUTH_SECRET=

# Outgoing mail. Founder notices go to FOUNDER_EMAIL.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
FOUNDER_EMAIL=mail@wealthdiscovery.in
