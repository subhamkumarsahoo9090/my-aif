# Copy this file to .env.local and fill in real values.
# config/projectmanager.js reads these on the server.
# AUTH_SECRET signs the demo session cookie. Optional for local development.

AUTH_SECRET=

# Atlas connection used by the Node server in ../server
MONGODB_URI=
MONGODB_DB=aif_wealthdiscovery

MAIL_CLIENT_ID=
MAIL_CLIENT_SECRET=

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
