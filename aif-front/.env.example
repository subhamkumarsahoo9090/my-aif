# Copy this file to .env.local and fill in real values.
# NEXT_PUBLIC_API_ORIGIN is the API base URL used by config/endapi.js.
# AUTH_SECRET signs the demo session cookie. Optional for local development.

NEXT_PUBLIC_API_ORIGIN=http://localhost:4000

AUTH_SECRET=

# MongoDB is configured in server/.env, not here.

MAIL_CLIENT_ID=
MAIL_CLIENT_SECRET=

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
